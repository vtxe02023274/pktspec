{
  "name": "pktspec",
  "version": "0.2.0",
  "description": "Describe your game packets once in YAML, then generate encoders, decoders, docs and tests for each language.",
  "keywords": [
    "packet",
    "protocol",
    "codegen",
    "game-server",
    "binary",
    "yaml"
  ],
  "homepage": "https://github.com/vtxe02023274/pktspec#readme",
  "bugs": {
    "url": "https://github.com/vtxe02023274/pktspec/issues"
  },
  "license": "MIT",
  "author": "Leng Niu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vtxe02023274/pktspec.git"
  },
  "type": "module",
  "bin": {
    "pktspec": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "prepublishOnly": "tsc -p tsconfig.build.json && npm test"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
